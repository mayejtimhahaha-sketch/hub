--// SERVICES
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

--// REMOTE
local remote = ReplicatedStorage:WaitForChild("Events"):WaitForChild("ChangeCar")

--// GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = player:WaitForChild("PlayerGui")

--// MAIN FRAME (ตัวหลัก)
local Main = Instance.new("Frame")
Main.Parent = ScreenGui
Main.Size = UDim2.new(0, 220, 0, 60)
Main.Position = UDim2.new(0.5, -110, 0.5, -30)
Main.BackgroundTransparency = 1

--// GLOW
local Glow = Instance.new("Frame")
Glow.Parent = Main
Glow.Size = UDim2.new(1, 10, 1, 10)
Glow.Position = UDim2.new(0, -5, 0, -5)
Glow.BackgroundColor3 = Color3.fromRGB(170, 0, 255)
Glow.BackgroundTransparency = 0.7
Instance.new("UICorner", Glow).CornerRadius = UDim.new(0, 16)

--// BACKGROUND (ดำ)
local Background = Instance.new("Frame")
Background.Parent = Main
Background.Size = UDim2.new(1, 0, 1, 0)
Background.BackgroundColor3 = Color3.fromRGB(15,15,15)
Background.BackgroundTransparency = 0.1
Instance.new("UICorner", Background).CornerRadius = UDim.new(0, 14)

--// BUTTON
local Button = Instance.new("TextButton")
Button.Parent = Main
Button.Size = UDim2.new(0.9, 0, 0.8, 0)
Button.Position = UDim2.new(0.05, 0, 0.1, 0)
Button.Text = "AUTO SPAWN"
Button.TextColor3 = Color3.fromRGB(255,255,255)
Button.TextScaled = true
Button.Font = Enum.Font.GothamBold
Button.BackgroundColor3 = Color3.fromRGB(20,20,20)

Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 12)

--// GRADIENT
local Gradient = Instance.new("UIGradient", Button)
Gradient.Color = ColorSequence.new{
	ColorSequenceKeypoint.new(0, Color3.fromRGB(140, 0, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
}

--// STROKE
local Stroke = Instance.new("UIStroke", Button)
Stroke.Thickness = 2
Stroke.Color = Color3.fromRGB(170, 0, 255)
Stroke.Transparency = 0.2

--// STATE
local running = false

--// SPAM
local function spamCar()
	while running do
		remote:FireServer("Spawns", "Red Viper")
		task.wait(0.1)
	end
end

--// CLICK EFFECT
Button.MouseButton1Down:Connect(function()
	Button.Size = UDim2.new(0.85, 0, 0.75, 0)
end)

Button.MouseButton1Up:Connect(function()
	Button.Size = UDim2.new(0.9, 0, 0.8, 0)
end)

--// CLICK
Button.MouseButton1Click:Connect(function()
	running = not running
	
	if running then
		Button.Text = "RUNNING"
		Glow.BackgroundTransparency = 0.5
		task.spawn(spamCar)
	else
		Button.Text = "AUTO SPAWN"
		Glow.BackgroundTransparency = 0.7
	end
end)

--// DRAG (ลากทั้ง Main)
local dragging = false
local dragStart, startPos

Main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 
	or input.UserInputType == Enum.UserInputType.Touch then
		
		dragging = true
		dragStart = input.Position
		startPos = Main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging then
		local delta = input.Position - dragStart
		Main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)
